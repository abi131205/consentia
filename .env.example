# Consentia Environment Variables Configuration Template
# Copy this file to .env and insert your real Gemini API Key

# Google Gemini API Key (Required for live Gemini 2.5 Flash model features)
# Get a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_google_gemini_api_key_here

# Server Port (Default: 5000)
PORT=5000
